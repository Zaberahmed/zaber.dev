{
  "tasks": {
    "dev:api": "deno run --allow-env --allow-net --watch apps/api/index.ts",
    "dev": "deno task dev:api",
    "test": "deno test",
    "lint": "deno lint",
    "format": "deno fmt"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@trpc/client": "npm:@trpc/client@^11.0.0",
    "@trpc/server": "npm:@trpc/server@^11.0.0",
    "zod": "npm:zod@^3.24.2"
  },
  "workspace": ["apps/api", "apps/shared"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  },
  "deploy": {
    "project": "zaber-dev",
    "exclude": ["**/node_modules"],
    "include": ["apps/api", "apps/shared"],
    "entrypoint": "apps/api/index.ts"
  }
}
