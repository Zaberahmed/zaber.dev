{
  "tasks": {
    "dev": "deno run --watch server/index.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@trpc/client": "npm:@trpc/client@^11.0.0",
    "@trpc/server": "npm:@trpc/server@^11.0.0",
    "zod": "npm:zod@^3.24.2"
  },
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  },
  "deploy": {
    "project": "zaber.dev",
    "entrypoint": "server/index.ts"
  }
}
