{
  "tasks": {
    "db:generate": "deno task --cwd=apps/api db:generate",
    "db:migrate": "deno task --cwd=apps/api db:migrate",

    "dev:api": "deno task --cwd=apps/api dev",
    "dev:web": "deno task --cwd=apps/web dev",
    "dev:server": "deno task --cwd=apps/server dev",

    "build:web": "deno task --cwd=apps/web build",
    "preview:web": "deno task --cwd=apps/web preview",
    "serve:web": "deno task --cwd=apps/web serve",

    "deploy:server": "deno deploy --prod --ignore=node_modules,.git,.vscode,.zed,.kilo",

    "dev": "deno task dev:api & deno task dev:web",
    "test": "deno test",
    "lint": "deno lint",
    "format": "deno fmt",
    "deploy": "deno task deploy:server"
  },
  "nodeModulesDir": "auto",

  "workspace": [
    "apps/api",
    "apps/web",
    "apps/server",
    "packages/shadcn",
    "packages/constants"
  ],

  "deploy": {
    "install": "deno install",
    "build": "deno task build:web",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "apps/server/index.ts"
    }
  }
}
