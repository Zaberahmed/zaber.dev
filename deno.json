{
  "tasks": {
    "dev:api": "deno run --allow-env --allow-net --allow-read --env-file=.env.local --watch apps/api/index.ts",
    "deploy:api": "deployctl deploy --project=zaber-api --prod apps/api/index.ts",

    "dev:web": "cd apps/web && deno run -A --node-modules-dir npm:vite",
    "build:web": "cd apps/web && deno run -A --node-modules-dir npm:vite build --mode production",
    "preview:web": "cd apps/web && deno run -A --node-modules-dir npm:vite preview",
    "serve:web": "cd apps/web && deno run --allow-net --allow-read jsr:@std/http@1/file-server dist/",
    "deploy:web": "deployctl deploy --project=zaber --prod apps/web/server.ts",

    "dev": "deno task dev:api & deno task dev:web",
    "test": "deno test",
    "lint": "deno lint",
    "format": "deno fmt",
    "deploy": "deno task deploy:api & deno task deploy:web"
  },
  "nodeModulesDir": "auto",

  "workspace": ["apps/api", "apps/shared", "apps/web"],

  "deploy": {
    "api": {
      "project": "zaber-api",
      "exclude": ["**/node_modules"],
      "include": ["apps/api", "apps/shared"],
      "entrypoint": "apps/api/index.ts"
    },
    "web": {
      "project": "zaber",
      "exclude": ["**/node_modules"],
      "include": ["./.env", "apps/web", "apps/shared"],
      "entrypoint": "apps/web/server.ts"
    }
  }
}
