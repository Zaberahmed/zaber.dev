# Production environment variables (required at runtime)
# Used by: apps/server (deployctl --env-file=.env.production) and apps/web (Vite build)
# Local-only vars (API_LOCAL_PORT, APP_ENV) are NOT listed here — deployctl validates that
# every var in this file is also present in the env file at deploy time.

DEPLOYMENT_MODE=
JWT_SECRET=
ADMIN_SETUP_KEY=
DATABASE_URL=
