{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "ui/*": ["../../packages/shadcn/src/components/ui/*"],
      "@/*": ["../../packages/shadcn/src/*"]
    }
  },
  "include": ["src", "../../packages/shadcn/src"],
  "references": [{ "path": "./vite.config.ts" }]
}
