{
  "name": "@scope/api",
  "exports": {
    "./trpc": "./trpc/index.ts"
  },
  "tasks": {
    "dev": "deno run --allow-env --allow-net --allow-read --allow-ffi --env-file=.env --watch index.ts",
    "db:generate": "deno run -A npm:drizzle-kit generate",
    "db:migrate": "deno run -A db/migrate.ts"
  },
  "imports": {
    "@modules": "./modules/index.ts",
    "@trpc": "./trpc/index.ts",
    "@constants": "./constants/index.ts",
    "@lib": "./lib/index.ts",
    "@db": "./db/index.ts",

    "@trpc/server": "npm:@trpc/server@^11.1.2",
    "@types/cors": "npm:@types/cors@^2.8.17",
    "@types/pg": "npm:@types/pg@^8.10.7",
    "cors": "npm:cors@^2.8.5",
    "drizzle-orm": "npm:drizzle-orm@^0.29.3",
    "drizzle-kit": "npm:drizzle-kit@^0.20.10",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.5",
    "pg": "npm:pg@^8.11.3",
    "zod": "npm:zod@^3.22.4",
    "jose": "npm:jose@^5.2.0"
  },
  "deploy": {
    "project": "zaber-api",
    "exclude": ["**/node_modules"],
    "include": ["apps/api", "packages/constants"],
    "entrypoint": "apps/api/index.ts"
  }
}
